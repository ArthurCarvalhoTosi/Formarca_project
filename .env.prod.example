# Copy to .env.prod and fill in. Never commit .env.prod.
# Local smoke test: DOMAIN=localhost and HTTP_PORT=8088 (Caddy stays on HTTP).
# Production: DOMAIN=painel.formarca.com.br, HTTP_PORT=80, HTTPS_PORT=443.

DOMAIN=localhost
HTTP_PORT=8088
HTTPS_PORT=8443

# SQL Express password. Avoid quotes, dollar signs, and spaces (healthcheck expands it in a shell).
MSSQL_SA_PASSWORD=ChangeMe_Express123
DB_CONNECTION=Server=sqlserver,1433;Database=Formarca;User Id=sa;Password=ChangeMe_Express123;TrustServerCertificate=True;

# At least 32 random bytes.
JWT_KEY=change-me-to-a-long-random-secret-key

AUTENTIQUE_API_KEY=
AUTENTIQUE_WEBHOOK_SECRET=
AUTENTIQUE_SIGNER_EMAIL=
